{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FRAME",
            "ROI",
            "AUDIO",
            "TRANSCRIPT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ref",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "ALT",
                "HDG"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field"
        },
        "roi": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Roi"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "ref",
        "field",
        "roi"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FieldVerdict": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "READBACK",
            "SETTING"
          ],
          "title": "Stage",
          "type": "string"
        },
        "field": {
          "enum": [
            "ALT",
            "HDG",
            "CALLSIGN"
          ],
          "title": "Field",
          "type": "string"
        },
        "instruction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instruction Id"
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Id"
        },
        "expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "result": {
          "enum": [
            "NORMAL",
            "MISMATCH",
            "UNVERIFIED"
          ],
          "title": "Result",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "wait_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Until"
        }
      },
      "required": [
        "stage",
        "field",
        "instruction_id",
        "observation_id",
        "expected",
        "actual",
        "result",
        "reason"
      ],
      "title": "FieldVerdict",
      "type": "object"
    },
    "IncidentEvidence": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Id"
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Segment Id"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Unavailable Reason"
        }
      },
      "required": [
        "observation_id",
        "observed_at",
        "frame_id",
        "segment_id",
        "attempt_id",
        "evidence_refs",
        "evidence_unavailable_reason"
      ],
      "title": "IncidentEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "occurrence_id": {
      "title": "Occurrence Id",
      "type": "string"
    },
    "flight_id": {
      "title": "Flight Id",
      "type": "string"
    },
    "instruction_id": {
      "title": "Instruction Id",
      "type": "string"
    },
    "stage": {
      "enum": [
        "READBACK",
        "SETTING"
      ],
      "title": "Stage",
      "type": "string"
    },
    "field": {
      "enum": [
        "ALT",
        "HDG",
        "CALLSIGN"
      ],
      "title": "Field",
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "SUPERSEDED",
        "ENDED_UNRESOLVED"
      ],
      "title": "Status",
      "type": "string"
    },
    "detected_at": {
      "title": "Detected At",
      "type": "string"
    },
    "first_evidence": {
      "$ref": "#/$defs/IncidentEvidence"
    },
    "latest_evidence": {
      "$ref": "#/$defs/IncidentEvidence"
    },
    "last_mismatch_evidence": {
      "$ref": "#/$defs/IncidentEvidence"
    },
    "current_check": {
      "$ref": "#/$defs/FieldVerdict"
    },
    "first_check": {
      "$ref": "#/$defs/FieldVerdict"
    },
    "reobserved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reobserved At"
    },
    "reverified_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reverified At"
    },
    "resolved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resolved At"
    },
    "closed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Closed At"
    },
    "close_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Close Reason"
    },
    "resolution_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/IncidentEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "notified_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notified At"
    },
    "voice_completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Voice Completed At"
    }
  },
  "required": [
    "occurrence_id",
    "flight_id",
    "instruction_id",
    "stage",
    "field",
    "status",
    "detected_at",
    "first_evidence",
    "latest_evidence",
    "last_mismatch_evidence",
    "current_check",
    "first_check",
    "reobserved_at",
    "reverified_at",
    "resolved_at",
    "closed_at",
    "close_reason",
    "resolution_evidence",
    "notified_at",
    "voice_completed_at"
  ],
  "title": "IncidentV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radar:contracts:incident-v1"
}
