        },
        "time_basis": {
          "enum": [
            "CAPTURED",
            "HOST_RECEIVE",
            "UNKNOWN"
          ],
          "title": "Time Basis",
          "type": "string"
        },
        "time_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
