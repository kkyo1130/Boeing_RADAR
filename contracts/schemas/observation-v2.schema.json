{
  "$defs": {
    "AltitudeReading": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "validity": {
                "const": "VALID"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "validity": {
          "enum": [
            "VALID",
            "UNREADABLE",
            "INVALID"
          ],
          "title": "Validity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "raw_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "const": "ft",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "validity",
        "reason",
        "raw_text",
        "quality",
        "value",
        "unit"
      ],
      "title": "AltitudeReading",
      "type": "object"
    },
    "AtcObservation": {
